# Website recruitment runtime. Copy to an untracked .env for local development.
PORT=5173

# Local development safely defaults to an operating-system temporary directory.
# In production, set these only after /data is verified as the Website service's
# private persistent volume, never a Patch OS volume.
# RECRUITMENT_DATA_ROOT=/data/recruitment
# RECRUITMENT_PERSISTENCE_ACK=website-volume-mounted
RECRUITMENT_MAX_AUDIO_BYTES=12582912

# Use a random value of at least 32 bytes. Never reuse a Patch OS secret.
RECRUITMENT_COOKIE_SECRET=replace-with-a-website-only-random-secret

# Exactly 12 characters. This becomes /assessment/<code> and is intentionally lightweight access.
RECRUITMENT_REVIEWER_SECRET=ABC123XYZ789
RECRUITMENT_REVIEWER_SESSION_MINUTES=20

# Website-only Resend credentials and sender configuration.
RESEND_API_KEY=re_replace_me
RECRUITMENT_EMAIL_FROM=Patch Applications <applications@patch.app>
RECRUITMENT_EMAIL_REPLY_TO=patrick@patch.app
RECRUITMENT_BOOKING_URL=https://www.patch.app/coaching
