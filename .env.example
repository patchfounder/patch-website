# Website recruitment runtime. Copy to an untracked .env for local development.
PORT=5173

# Local development safely defaults to an operating-system temporary directory.
# In production, set these only after /data is verified as the Website service's
# private persistent volume, never a Patch OS volume.
# RECRUITMENT_DATA_ROOT=/data/recruitment
# RECRUITMENT_PERSISTENCE_ACK=website-volume-mounted
RECRUITMENT_MAX_AUDIO_BYTES=12582912

# Use a random value of at least 32 bytes. Never reuse a Patch OS secret.
RECRUITMENT_COOKIE_SECRET=replace-with-a-website-only-random-secret

# Exactly 12 characters. This becomes /assessment/<code> and is intentionally lightweight access.
RECRUITMENT_REVIEWER_SECRET=ABC123XYZ789
RECRUITMENT_REVIEWER_SESSION_MINUTES=20

# Server-only salted scrypt hash for /application and /administration. Never put the real password
# in source, a VITE_ variable, or a URL. Leave empty to disable password sign-in.
RECRUITMENT_ADMIN_PASSWORD_HASH=

# Website-only Resend credentials and sender configuration.
RESEND_API_KEY=re_replace_me
RECRUITMENT_EMAIL_FROM=Patch Applications <applications@patch.app>
RECRUITMENT_EMAIL_REPLY_TO=patrick@patch.app
RECRUITMENT_BOOKING_URL=https://www.patch.app/coaching

# Coach registration only: dedicated server-to-server integration (never VITE_).
# Configure these on the two approved existing services; never commit real secrets.
COACH_REGISTRATION_BACKEND_URL=https://os.patch.app/api/integrations/coach-registration
COACH_REGISTRATION_SECRET=
COACH_REGISTRATION_PUBLIC_ORIGIN=https://www.patch.app
# Uses the existing RESEND_API_KEY and RECRUITMENT_EMAIL_FROM/REPLY_TO by default.
# Notifications with a VCF attachment go only to patrick@patch.app.

# Academy video rooms. Server-only: never prefix these with VITE_ or publish them.
# Configure the existing LiveKit project on the Website service only after release approval.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Legacy personal-invitation API only. The shared Activation room needs no host password.
# Retain an existing value to preserve old invitation records; do not enter it on the new page.
TRAINING_HOST_ACCESS_KEY=
TRAINING_PUBLIC_ORIGIN=https://www.patch.app
# Dedicated private directory on the existing Website persistent volume, outside the checkout.
# TRAINING_DATA_DIR=/data/training
TRAINING_ACTIVATION_BOOKING_URL=https://cal.com/patchapp/activation
# The current Cal.com event is 30 minutes. Set 5 plus VERIFIED=true only after changing/verifying it.
TRAINING_ACTIVATION_BOOKING_MINUTES=30
TRAINING_ACTIVATION_BOOKING_DURATION_VERIFIED=false
